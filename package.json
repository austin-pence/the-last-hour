{
  "name": "the-last-hour",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only database --project demo-last-hour \"node --test tests/rules.mjs\"",
    "build": "node scripts/build.mjs",
    "test:browser": "firebase emulators:exec --only auth,database --project demo-last-hour \"node tests/browser.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0",
    "playwright": "1.64.1"
  }
}